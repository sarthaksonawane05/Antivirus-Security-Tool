<Window x:Class="Antivirus_and_security.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:Antivirus_and_security.View"
        Title="Cyber Defender"
        WindowStartupLocation="CenterScreen"
        Width="1100"
        Height="750"
        MinWidth="800"
        MinHeight="600"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}">

    <!-- ❌ REMOVE Viewbox (this was breaking responsiveness) -->

    <Grid>

        <!-- MAIN GRID -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="{DynamicResource CardBackground}"
                CornerRadius="0,35,35,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="25">

                    <!-- LOGO -->
                    <Border Width="90"
                            Height="90"
                            CornerRadius="45"
                            Background="#00E5C3"
                            HorizontalAlignment="Center">

                        <TextBlock Text="🛡"
                                   FontSize="45"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- TITLE -->
                    <TextBlock Text="CYBER DEFENDER"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,20,0,0"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Advanced Security Suite"
                               Foreground="#00E5C3"
                               FontSize="13"
                               Margin="0,0,0,30"
                               HorizontalAlignment="Center"/>

                    <!-- NAV BUTTONS -->
                    <StackPanel>

                        <Button Content="🏠 Dashboard"
                                Height="55"
                                Margin="0,8"
                                Background="#1F2937"
                                Foreground="White"
                                Click="DashboardBtn_Click"/>

                        <Button Content="🛡 Protection"
                                Height="55"
                                Margin="0,8"
                                Background="#1F2937"
                                Foreground="White"
                                Click="ProtectionBtn_Click"/>

                        <Button Content="🔒 Privacy"
                                Height="55"
                                Margin="0,8"
                                Background="#1F2937"
                                Foreground="White"
                                Click="PrivacyBtn_Click"/>

                        <Button Content="⚡ Performance"
                                Height="55"
                                Margin="0,8"
                                Background="#1F2937"
                                Foreground="White"
                                Click="PerformanceBtn_Click"/>

                        <Button Content="⚙ Settings"
                                Height="55"
                                Margin="0,8"
                                Background="#1F2937"
                                Foreground="White"
                                Click="SettingsBtn_Click"/>

                    </StackPanel>

                    <!-- THEME -->
                    <TextBlock Text="Theme"
                               
                              Foreground="#00E5C3"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,25,0,10"
                               HorizontalAlignment="Center"/>

                    <Button Content="☀ Light Theme"
                            
                            Background="#1F2937"
                            Foreground="White"
                            Height="45"
                            Margin="0,5"
                            Click="LightTheme_Click"/>

                    <Button Content="🌙 Dark Theme"
                            Background="#1F2937"
                            Foreground="White"
                            Height="45"
                            Margin="0,5"
                            Click="DarkTheme_Click"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

        <!-- ================================================= -->
        <!-- MAIN CONTENT AREA -->
        <!-- ================================================= -->

        <Border Grid.Column="1"
                Margin="20"
                Background="{DynamicResource CardBackground}"
                CornerRadius="25"
                Padding="10">

            <ContentControl Name="MainContent"/>

        </Border>

    </Grid>

</Window>