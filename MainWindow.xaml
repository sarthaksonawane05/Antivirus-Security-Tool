<Window x:Class="morden_dark_dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureShield"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- ✅ RESPONSIVE GRID -->
        <Grid.ColumnDefinitions>

            <!-- Sidebar auto size (fits content) -->
            <ColumnDefinition Width="Auto"/>

            <!-- Main content takes remaining space -->
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Background="{DynamicResource CardBackground}"
                MinWidth="240"
                MaxWidth="320">

            <Grid Margin="15">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0" Margin="5">
                    <TextBlock Text="🛡 ThreatCleaner"
                               Foreground="{DynamicResource AccentColor}"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="Antivirus Pro"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="14"/>
                </StackPanel>

                <!-- NAVIGATION -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <Button Content="Dashboard"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="DashboardBtn_Click"/>

                        <Button Content="Scan"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="ScanBtn_Click"/>

                        <Button Content="Real-time Protection"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="RealTimeBtn_Click"/>

                        <Button Content="Quarantine"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="QuarantineBtn_Click"/>

                        <Button Content="Threat History"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="ThreatBtn_Click"/>

                        <Button Content="Firewall"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="FirewallBtn_Click"/>

                        <Button Content="Privacy"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="PrivacyBtn_Click"/>

                        <Button Content="Performance"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="PerformanceBtn_Click"/>

                        <Button Content="Settings"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="SettingsBtn_Click"/>

                    </StackPanel>

                </ScrollViewer>

                <!-- THEME -->
                <StackPanel Grid.Row="2" Margin="5">

                    <TextBlock Text="Theme"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="16"
                               Margin="0,10"
                               HorizontalAlignment="Center"/>

                    <Button Content="🌙 Dark Theme"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="DarkTheme_Click"/>

                    <Button Content="☀ Light Theme"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="LightTheme_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Border Grid.Column="1"
                Margin="15"
                Background="{DynamicResource CardBackground}"
                CornerRadius="20">

            <ContentControl x:Name="MainContent"/>

        </Border>

    </Grid>

</Window>